---
import { render, type CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
interface Props {
  note: CollectionEntry<"notes">;
  compact?: boolean;
}
const { note, compact = true } = Astro.props;
const Heading = compact ? "h3" : "h2";
const { Content } = await render(note);
---

<article
  class:list={["short-note", { "short-note--full": !compact }]}
  id={`note-${note.id}`}
>
  <div class="note-meta">
    <FormattedDate date={note.data.pubDate} />
    {note.data.example && <span class="note-example">示例短笺</span>}
  </div>
  <Heading class="note-title">{note.data.title}</Heading>
  <div class="note-copy">
    <Content />
  </div>
</article>

<style>
  .short-note {
    position: relative;
    padding: 0 0 0 20px;
    border-left: 1px solid #aad9f033;
    min-width: 0;
  }
  .short-note::before {
    content: "";
    position: absolute;
    left: -3px;
    top: 8px;
    width: 5px;
    height: 5px;
    background: #c5eaf5;
    border-radius: 50%;
    box-shadow: 0 0 9px #9ed8ff88;
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: #94abc5;
    font-size: 10px;
  }
  .note-example {
    border: 1px solid #aacfe92b;
    border-radius: 4px;
    padding: 0 5px;
    font-size: 9px;
    color: #acc9dc;
  }
  .note-title {
    font-family: var(--serif);
    font-size: 17px;
    color: #d8e8f5;
    margin: 10px 0;
    line-height: 1.7;
  }
  .note-copy {
    font-size: 12px;
    color: #acbfd4;
    line-height: 2;
    overflow-wrap: anywhere;
  }
  .note-copy :global(p) {
    margin: 8px 0;
  }
  .note-copy :global(a) {
    color: #b9e5f6;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .note-copy :global(code) {
    color: #d3e8f3;
    background: #b9e5f611;
    border-radius: 3px;
    padding: 2px 4px;
  }
  .note-copy :global(pre) {
    overflow-x: auto;
    padding: 10px;
  }
  .note-copy :global(img) {
    border-radius: 8px;
  }
  .note-copy :global(ul),
  .note-copy :global(ol) {
    padding-left: 1.4em;
  }
  .short-note--full .note-title {
    font-size: 22px;
  }
  .short-note--full .note-copy {
    font-size: 14px;
  }
</style>
