---
import { SITE_TITLE } from "../consts";
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, "");
const links = [
  ["", "序章"],
  ["blog", "手记"],
  ["archive", "归档"],
  ["about", "关于"],
];
---

<a class="skip-link" href="#main">
  跳转到内容
</a>
<header class="site-header glass">
  <a class="brand" href={base} aria-label={`${SITE_TITLE}首页`}>
    <span class="brand-moon" aria-hidden="true">
      ☾
    </span>
    <span>
      {SITE_TITLE}
      <small>MOONLIT JOURNAL</small>
    </span>
  </a>
  <nav aria-label="主导航">
    {links.map(([url, label]) => (
      <a
        href={`${base}${url ? `${url}/` : ""}`}
        aria-current={
          (url ? path.startsWith(url) : path === "") ? "page" : undefined
        }
      >
        {label}
      </a>
    ))}
  </nav>
  <button
    class="motion-toggle"
    type="button"
    aria-pressed="false"
    title="暂停背景动效"
  >
    动效 · 开
  </button>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".motion-toggle");
  let paused = matchMedia("(prefers-reduced-motion: reduce)").matches;
  try {
    paused = localStorage.getItem("moon-motion") === "off" || paused;
  } catch {}
  function updateMotion() {
    document.documentElement.dataset.motion = paused ? "off" : "on";
    if (!button) return;
    button.textContent = paused ? "动效 · 关" : "动效 · 开";
    button.setAttribute("aria-pressed", String(paused));
    button.title = paused ? "开启背景动效" : "暂停背景动效";
  }
  updateMotion();
  button?.addEventListener("click", () => {
    paused = !paused;
    updateMotion();
    try {
      localStorage.setItem("moon-motion", paused ? "off" : "on");
    } catch {}
  });
</script>
