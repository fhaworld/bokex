---
import { getCollection } from "astro:content";
import ShortNote from "./ShortNote.astro";
const notes = (await getCollection("notes"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<section class="short-notes glass" aria-labelledby="short-notes-title">
  <p class="eyebrow">LITTLE THINGS, LATELY</p>
  <div class="short-notes-heading">
    <h3 id="short-notes-title">月下短笺</h3>
    <span aria-hidden="true">✧</span>
  </div>
  <p class="short-notes-intro">不必成篇，也值得留下。</p>
  <div class="short-notes-list">
    {notes.length ? (
      notes.map((note) => <ShortNote note={note} />)
    ) : (
      <p class="short-notes-intro">这里正等着下一点灵感。</p>
    )}
  </div>
  {notes.length > 0 && (
    <a class="quiet-link" href={`${import.meta.env.BASE_URL}notes/`}>
      翻阅全部短笺 <span>→</span>
    </a>
  )}
</section>

<style>
  .short-notes {
    padding: 26px;
    margin-bottom: 20px;
  }
  .eyebrow {
    font-size: 8px;
  }
  .short-notes-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 7px 0;
  }
  .short-notes-heading h3 {
    font-family: var(--serif);
    font-size: 21px;
    letter-spacing: 0.08em;
  }
  .short-notes-heading > span {
    color: #a9dceb;
    font-size: 23px;
  }
  .short-notes-intro {
    font-size: 11px;
    color: #94aac4;
    margin-bottom: 25px;
  }
  .short-notes-list {
    display: grid;
    gap: 26px;
  }
  .quiet-link {
    display: inline-flex;
    gap: 20px;
    margin-top: 24px;
    font-size: 11px;
  }
</style>
