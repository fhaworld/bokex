---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostCard from "../../components/PostCard.astro";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<SiteLayout title="全部手记">
  <section class="page-intro">
    <p class="eyebrow">THE JOURNAL</p>
    <h1>
      把日子，写成手记<span class="heading-dot">.</span>
    </h1>
    <p>一些探索，一些片刻。共 {posts.length} 篇文字，等待与你相遇。</p>
  </section>
  <section aria-label="查找文章">
    <div class="filter-bar glass">
      <label class="search-label">
        <span aria-hidden="true">⌕</span>
        <span class="sr-only">搜索文章标题、描述和正文</span>
        <input
          type="search"
          id="post-search"
          placeholder="搜索标题、内容或灵感…"
          autocomplete="off"
        />
      </label>
      <span id="result-count" aria-live="polite">
        {posts.length} 篇手记
      </span>
    </div>
    <div class="tag-filters" role="group" aria-label="按标签筛选">
      <button type="button" data-tag="" aria-pressed="true">
        全部
      </button>
      {tags.map((tag) => (
        <button type="button" data-tag={tag} aria-pressed="false">
          # {tag}
        </button>
      ))}
    </div>
    <div class="article-grid" id="post-results">
      {posts.map((post, index) => (
        <div
          data-post
          data-search={`${post.data.title} ${post.data.description} ${post.body ?? ""} ${post.data.tags.join(" ")}`.toLocaleLowerCase()}
          data-tags={JSON.stringify(post.data.tags)}
        >
          <PostCard post={post} index={index} />
        </div>
      ))}
    </div>
    <p id="empty-results" class="empty-state glass" hidden>
      这片夜空暂时没有找到对应的文字。试试其他关键词。
    </p>
    <noscript>
      <p>启用 JavaScript 后可以使用搜索与筛选，所有文章已列出。</p>
    </noscript>
  </section>
</SiteLayout>
<script>
  const search = document.querySelector<HTMLInputElement>("#post-search");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-tag]");
  const posts = document.querySelectorAll<HTMLElement>("[data-post]");
  let selectedTag = "";
  function filterPosts() {
    const query = search?.value.trim().toLocaleLowerCase() ?? "";
    let count = 0;
    posts.forEach((post) => {
      const matches =
        (post.dataset.search ?? "").includes(query) &&
        (!selectedTag ||
          JSON.parse(post.dataset.tags ?? "[]").includes(selectedTag));
      post.hidden = !matches;
      if (matches) count++;
    });
    const counter = document.querySelector("#result-count");
    if (counter) counter.textContent = `${count} 篇手记`;
    const empty = document.querySelector<HTMLElement>("#empty-results");
    if (empty) empty.hidden = count > 0;
  }
  search?.addEventListener("input", filterPosts);
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      selectedTag = button.dataset.tag ?? "";
      buttons.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === button)),
      );
      filterPosts();
    }),
  );
</script>
