---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import MoonlitSky from "../assets/moonlit-sky.png";
import SiteLayout from "../layouts/SiteLayout.astro";
import PostCard from "../components/PostCard.astro";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL;
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true">
      <Image
        src={MoonlitSky}
        alt=""
        widths={[700, 1180, 1672]}
        sizes="(max-width: 700px) 700px, (max-width: 1260px) 100vw, 1180px"
        format="webp"
        quality={88}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="tiny-line"></span> A JOURNAL AFTER DARK
      </p>
      <h1 id="hero-title">
        夜色渐深，
        <br />
        思绪<span>如月光。</span>
      </h1>
      <p class="hero-description">
        把未说完的话，写进夜里。
        <br />
        这里收藏技术、生活，以及那些一闪而过的灵感。
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}blog/`}>
          翻开手记 <span>↗</span>
        </a>
        <a class="quiet-link" href={`${base}about/`}>
          关于这个角落 <span>→</span>
        </a>
      </div>
      <div class="hero-caption">
        <span class="status-dot"></span> 夜未央，故事仍在继续
        <span class="caption-number">01 / ∞</span>
      </div>
    </div>
    <div class="moon-scene" aria-hidden="true">
      <div class="moon-cloud cloud-back"></div>
      <div class="moon-cloud cloud-front"></div>
      <div class="moon-shards">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </div>
      <span class="scene-coordinate">
        UNDER THE SAME MOON
      </span>
      <span class="scene-label">
        静夜
        <br />
        <small>THE SILENT BLUE</small>
      </span>
    </div>
  </section>
  <section class="home-notes" aria-labelledby="notes-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">RECENT ENTRIES</p>
        <h2 id="notes-title">
          最近的手记<span class="heading-dot">.</span>
        </h2>
      </div>
      <a class="quiet-link" href={`${base}blog/`}>
        全部文章 ↗
      </a>
    </div>
    <div class="home-grid">
      <div class="post-list">
        {posts.slice(0, 3).map((post, index) => (
          <PostCard post={post} index={index} />
        ))}
      </div>
      <aside class="journal-aside">
        <section class="aside-card glass">
          <span class="aside-symbol">☾</span>
          <p class="eyebrow">A LITTLE ABOUT HERE</p>
          <h3>文字的栖息地</h3>
          <p>
            记录遇到的问题，也记下路过的风景。在信息匆忙流动的世界里，留一点慢下来的空间。
          </p>
          <a class="quiet-link" href={`${base}about/`}>
            走近一点 →
          </a>
          <div class="aside-stats">
            <div>
              <strong>{String(posts.length).padStart(2, "0")}</strong>
              <span>篇手记</span>
            </div>
            <div>
              <strong>∞</strong>
              <span>种可能</span>
            </div>
          </div>
        </section>
        <div class="night-quote">
          <span>“</span>
          <p>
            有些光，
            <br />
            只有在夜里才能看见。
          </p>
          <small>NOTES UNDER THE MOON</small>
        </div>
      </aside>
    </div>
  </section>
</SiteLayout>
