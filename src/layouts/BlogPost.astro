---
import { Image } from "astro:assets";
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ArticleContinuation from "../components/ArticleContinuation.astro";
type Props = CollectionEntry<"blog">["data"] & {
  postId: string;
  headings?: MarkdownHeading[];
  minutes?: number;
};
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  headings = [],
  minutes = 1,
  postId,
} = Astro.props;
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<SiteLayout title={title} description={description}>
  <div class="reading-progress" aria-hidden="true"></div>
  <div class="article-top">
    <a class="quiet-link" href={`${import.meta.env.BASE_URL}blog/`}>
      ← 返回手记
    </a>
    <span class="eyebrow">A MOMENT, WRITTEN DOWN</span>
  </div>
  <header class="article-header">
    <div class="post-meta">
      <FormattedDate date={pubDate} />
      <span>约 {minutes} 分钟阅读</span>
    </div>
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="article-tags">
      {tags.map((tag) => (
        <span># {tag}</span>
      ))}
    </div>
    {updatedDate && (
      <p class="updated-date">
        更新于 <FormattedDate date={updatedDate} />
      </p>
    )}
  </header>
  <div class:list={["reading-layout", { "with-toc": toc.length > 0 }]}>
    <div class="reading-column">
      <article class="article-body glass prose">
        {heroImage && (
          <Image
            class="article-cover"
            src={heroImage}
            width={1120}
            height={560}
            alt=""
          />
        )}
        <slot />
        <div class="article-end">
          <span>✧</span>
          <p>写于月下，读于此刻。</p>
          <a href={`${import.meta.env.BASE_URL}blog/`}>继续翻阅 →</a>
        </div>
      </article>
      <ArticleContinuation postId={postId} />
    </div>
    {toc.length > 0 && (
      <aside class="article-toc glass">
        <p class="eyebrow">ON THIS PAGE</p>
        <h2>本篇目录</h2>
        <nav aria-label="文章目录">
          {toc.map((heading) => (
            <a
              class:list={{ "toc-sub": heading.depth === 3 }}
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</SiteLayout>
<script>
  let articleEvents: AbortController | undefined;
  function setupArticleTools() {
    articleEvents?.abort();
    const progress = document.querySelector<HTMLElement>(".reading-progress");
    if (!progress) return;
    articleEvents = new AbortController();

    document.querySelectorAll<HTMLElement>(".prose pre").forEach((pre) => {
      const code = pre.querySelector("code");
      if (!code || !navigator.clipboard || pre.querySelector(".copy-code"))
        return;
      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-code moon-button";
      const aura = document.createElement("span");
      aura.className = "moon-aura";
      aura.setAttribute("aria-hidden", "true");
      const label = document.createElement("span");
      label.textContent = "复制";
      button.append(aura, label);
      button.setAttribute("aria-label", "复制代码");
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? "");
          label.textContent = "已复制";
          button.setAttribute("aria-label", "代码已复制");
        } catch {
          label.textContent = "复制失败";
          button.setAttribute("aria-label", "代码复制失败");
        }
        setTimeout(() => {
          label.textContent = "复制";
          button.setAttribute("aria-label", "复制代码");
        }, 1800);
      });
      pre.append(button);
    });
    function updateProgress() {
      const distance = document.documentElement.scrollHeight - innerHeight;
      if (progress)
        progress.style.transform = `scaleX(${distance > 0 ? Math.min(1, scrollY / distance) : 1})`;
    }
    addEventListener("scroll", updateProgress, {
      passive: true,
      signal: articleEvents.signal,
    });
    addEventListener("resize", updateProgress, {
      signal: articleEvents.signal,
    });
    updateProgress();
  }
  document.addEventListener("astro:page-load", setupArticleTools);
  document.addEventListener("astro:before-swap", () => articleEvents?.abort());
</script>
